// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String    // "PROJECT", "TASK", "SHOPPING", "EVENT"
  status      String    @default("active") // "active", "done", "urgent", "hold"
  context     String?   // "Casa", "Trabajo", "Urgente"

  // Polymorphic fields
  progress    Int?      // For Projects (0-100)
  cost        Float?    // For Shopping
  category    String?   // For Shopping / grouping
  date        DateTime? // For Events/Deadlines

  // Collaboration
  isShared    Boolean   @default(false)
  visibility  String    @default("personal") // "personal" | "shared"

  // Hierarchy (for subtasks within projects)
  parentId    String?
  parent      Item?     @relation("SubItems", fields: [parentId], references: [id])
  children    Item[]    @relation("SubItems")

  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
